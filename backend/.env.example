# Porta do servidor
PORT=3333

# Segredo para assinar tokens JWT (gere uma string longa e aleatória em produção)
JWT_SECRET=troque-por-uma-chave-secreta-bem-forte-aqui

# ==============================================
# CREDENCIAIS DO DONO DO APP (Vitrine Pública)
# ==============================================
# Obtenha em: https://affiliate.shopee.com.br -> Open API
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql

# Outras lojas (opcional - pronto para expansão)
MERCADOLIVRE_AFFILIATE_TAG=
AMAZON_ASSOCIATE_TAG=
ALIEXPRESS_APP_KEY=

# ==============================================
# CANAIS PADRÃO (Opcional - cada afiliado PRO pode salvar os seus)
# ==============================================
TELEGRAM_BOT_TOKEN=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_URL=

# Servidor central Evolution API (permite conectar WhatsApp só pelo número + código de 8 dígitos)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
